# Environment variables for the Document Agent hosted agent.
# Copy to `.env` for local runs (`azd ai agent run`). In Foundry these values are
# injected from the azd environment / Bicep outputs and Managed Identity is used.

# --- Foundry project (agent hosting, threads, files -- NOT model inference) ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-spoke-foundry-account>.services.ai.azure.com/api/projects/<project>

# --- Central AI Gateway (model inference) ---
# Document Agent is a Foundry HOSTED agent. Per
# 01_PLATFORM_MODEL_FEDERATED_ARCH_v2.md ("Hosted-agent feasibility"), the
# admin-connected-model / Foundry-project-connection mechanism is prompt-agent
# only, so model calls do NOT go through a Foundry connection and do NOT use
# <connectionName>/<modelName>. Instead this is an ordinary OpenAI-compatible
# HTTP call straight to the central APIM gateway, authenticated with this
# workload's own managed identity -- see main.py:_gateway_chat_client.
AI_GATEWAY_BASE_URL=https://<central-apim-name>.azure-api.net/openai
AI_GATEWAY_AUDIENCE=api://central-ai-gateway
AI_GATEWAY_API_VERSION=2024-10-21
# Model deployment name as published on the CENTRAL Foundry account (not a
# connection name -- this account has no model of its own).
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1

# --- Azure AI Content Understanding (OCR) ---
# Shares the Foundry AIServices account endpoint (no separate resource needed).
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://<your-foundry-resource>.cognitiveservices.azure.com/
# Optional: use a key instead of Managed Identity / az login for local testing.
# AZURE_CONTENT_UNDERSTANDING_KEY=<key>
# Optional overrides.
# AZURE_CONTENT_UNDERSTANDING_ANALYZER=prebuilt-read
# AZURE_CONTENT_UNDERSTANDING_API_VERSION=<supported-api-version>

# --- Assessment workflow (optional steps) ---
# Enable the optional FINANCIAL_SUMMARY validation step (requires a FINANCIAL_SUMMARY document attached).
# RUN_VALIDATION=false
# Enable the optional correction step (runs only when validation flags a warning).
# RUN_CORRECTION=false

# --- Logging ---
# LOG_LEVEL=INFO

# Local trace export only. In Foundry this reserved variable is injected from
# the project's Application Insights connection, not the agent env map.
# APPLICATIONINSIGHTS_CONNECTION_STRING=<connection-string>
# The caller needs Monitoring Metrics Publisher on the component and private access.
